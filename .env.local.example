# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Canonical site URL (single source of truth for absolute URLs and magic links)
# No trailing slash.
# For development: http://localhost:3000
# For production: https://www.stoovaapp.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Keys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# USDA FoodData Central API (https://fdc.nal.usda.gov/api-key-signup.html)
# Required for food search. Without this, falls back to DEMO_KEY (50 req/day limit)
USDA_API_KEY=your_usda_api_key_here

# Optional: For additional logging
# DEBUG=1

# Marketing analytics and search verification (public marketing pages only).
# Leave unset to disable. GA never loads inside the app (health data).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
